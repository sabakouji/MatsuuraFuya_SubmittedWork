// ピクセルシェーダーの入力構造体
struct VS_OUTPUT
{
	float4 Pos   : SV_POSITION;
	float4 Color : COLOR0;
};

//
// ピクセルシェーダー
//
float4 PS(VS_OUTPUT In) : SV_Target
{
	return In.Color;
}
